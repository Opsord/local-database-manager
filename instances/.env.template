# ==============================================================================
# Database Instance Configuration Template
# ==============================================================================
# Engine options: postgres | sqlserver
# Runtime options: docker | podman

# --- PostgreSQL Example ---
# ENGINE=postgres
# RUNTIME=docker
#
# CONTAINER_NAME=pg-example
# COMPOSE_PROJECT_NAME=pg-example
# MEMORY_LIMIT=512M                # Recommended: 512M - 1G
#
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=example_db
# POSTGRES_SCHEMA=public
# POSTGRES_VERSION=18          # majors 14-18; managed by wizard
# POSTGRES_VOLUME=pgdata_example_18  # auto-derived by the app; do not invent manually

# --- SQL Server Example ---
# ENGINE=sqlserver
# RUNTIME=docker
#
# CONTAINER_NAME=sql-example
# COMPOSE_PROJECT_NAME=sql-example
# MEMORY_LIMIT=2G                  # Recommended minimum: 2G (MSSQL requirement)
#
# SQLSERVER_PORT=1433
# SA_PASSWORD=SuperSecurePass123!
# SQLSERVER_DB=example_db
# SQLSERVER_SCHEMA=dbo
# SQLSERVER_VOLUME=sqlserver_example
